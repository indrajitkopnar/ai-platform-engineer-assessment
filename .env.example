# Copy to .env and adjust. Never commit .env (it is in .gitignore).

# --- LLM gateway -------------------------------------------------------------
# mock = fully offline, deterministic (default, no key needed)
# openai_compatible = any /chat/completions API: OpenAI, Azure OpenAI v1, Ollama, vLLM, LiteLLM proxy
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Local open model with Ollama instead (no data leaves the machine):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# --- Embeddings (chatbot retrieval) -------------------------------------------
# local_tfidf = offline default; openai_compatible = real semantic embeddings via the same gateway
EMBEDDING_PROVIDER=local_tfidf
EMBEDDING_MODEL=text-embedding-3-small
# With Ollama: EMBEDDING_MODEL=nomic-embed-text

# --- Tuning ------------------------------------------------------------------
CLASSIFIER_CONFIDENCE_THRESHOLD=0.50
RETRIEVAL_TOP_K=4
# Re-tune MIN_RELEVANCE on the golden set when switching to real embeddings (their scale differs).
MIN_RELEVANCE=0.10
